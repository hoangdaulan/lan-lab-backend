# Copy to .env and change every secret. .env is git-ignored.

POSTGRES_USER=judge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=judge

# Signs JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Host port published on 0.0.0.0 for LAN clients.
API_PORT=8080

# UID/GID the api and worker containers run as. They must own ./data (bind
# mount). Set to your host user (`id -u`, `id -g`) so you can edit test files
# without sudo, or keep 10001 and `sudo chown -R 10001:10001 data`.
APP_UID=10001
APP_GID=10001

# Submissions judged in parallel per worker (not tuned yet).
WORKER_CONCURRENCY=2

# Only for running binaries outside Compose (go run ./cmd/api):
# DATABASE_URL=postgres://judge:change-me@localhost:5432/judge?sslmode=disable
# HTTP_ADDR=:8080
# DATA_DIR=./data
# WORKER_POLL_INTERVAL=1s
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h

# First teacher for `make seed` (pass on the command line rather than storing
# the password here), e.g.:
#   SEED_TEACHER_CODE=GV01 SEED_TEACHER_FULLNAME="Nguyen Van A" SEED_TEACHER_PASSWORD=... make seed

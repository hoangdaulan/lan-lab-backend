# Copy to .env and change every secret. .env is git-ignored.

POSTGRES_USER=judge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=judge

# Signs JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Host port published on 0.0.0.0 for LAN clients.
API_PORT=8080

# Submissions judged in parallel per worker (not tuned yet).
WORKER_CONCURRENCY=2

# Only for running binaries outside Compose (go run ./cmd/api):
# DATABASE_URL=postgres://judge:change-me@localhost:5432/judge?sslmode=disable
# HTTP_ADDR=:8080
# DATA_DIR=./data
# WORKER_POLL_INTERVAL=1s

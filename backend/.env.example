# Copy to .env and change every secret. .env is git-ignored.

# Compose project name (defaults to the directory name). Set a different
# one to run a second copy on the same machine.
# COMPOSE_PROJECT_NAME=lanjudge

POSTGRES_USER=judge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=judge

# Signs JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Host port published on 0.0.0.0 for LAN clients.
API_PORT=8080

# HTTPS port for browsers (screen sharing needs HTTPS). The API creates a
# self-signed certificate in ./data/tls on start; list the server's LAN IP
# here so the certificate matches it (comma-separated, e.g. 192.168.1.9).
API_HTTPS_PORT=8443
TLS_HOSTS=

# PostgreSQL port on 127.0.0.1 only (host tools, integration tests).
DB_PORT=5433

# UID/GID the api and worker containers run as. They must own ./data (bind
# mount). Set to your host user (`id -u`, `id -g`) so you can edit test files
# without sudo, or keep 10001 and `sudo chown -R 10001:10001 data`.
APP_UID=10001
APP_GID=10001

# Submissions judged in parallel per worker (not tuned yet).
WORKER_CONCURRENCY=2

# Hand-written socket features (docs/net-protocols.md).
# Shared secret between the API's job dispatcher and workers (openssl rand -hex 16).
DISPATCH_TOKEN=
# Where workers get jobs pushed from: api:7070 (default), empty = polling only.
# WORKER_DISPATCH_ADDR=api:7070
# UDP broadcast discovery port (0 = off) and the LAN IP to advertise
# (defaults to the first TLS_HOSTS entry). Needs docker-compose.lan.yml.
# DISCOVERY_PORT=9999
# ADVERTISE_HOST=192.168.1.9
# Mirror teacher announcements to this UDP multicast group (empty = off).
# ANNOUNCE_MULTICAST_ADDR=239.255.42.99:9998

# Only for running binaries outside Compose (go run ./cmd/api):
# DATABASE_URL=postgres://judge:change-me@localhost:5432/judge?sslmode=disable
# HTTP_ADDR=:8080
# DATA_DIR=./data
# WORKER_POLL_INTERVAL=1s
# WORKER_LEASE=60s
# Extra Origin host patterns allowed to open the WebSocket (front-end dev
# server), comma-separated; same-origin is always allowed:
# WS_ALLOWED_ORIGINS=localhost:5173
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h

# First teacher for `make seed` (pass on the command line rather than storing
# the password here), e.g.:
#   SEED_TEACHER_CODE=GV01 SEED_TEACHER_FULLNAME="Nguyen Van A" SEED_TEACHER_PASSWORD=... make seed
